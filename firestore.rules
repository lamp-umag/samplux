rules_version = '2';

// samplux (samplux-lamp) — Firestore security rules.
//
// To apply: Firebase Console → samplux-lamp → Firestore Database → Rules
// → paste this whole file → Publish. (Or `firebase deploy --only firestore:rules`.)
//
// Paths used by the app:
// - surveys/<surveyId>: a survey definition (items, optionSets, settings),
//   authored via builder.html. Publicly readable once published so index.html
//   can render it; only admins can write.
// - responses/<surveyId>/entries/<responseId>: one survey response, written
//   anonymously by index.html on submit. Validated dynamically against the
//   matching surveys/<surveyId> doc (must exist and be published) instead of
//   a hardcoded id list — new surveys work the moment they're published, no
//   rules redeploy needed.
// - responses/<surveyId>/audio/<responseId>__<itemId>: voice answers (Bytes), see below.
// - consents/<consentId>: one consent record per response of a survey with
//   settings.consent (js/consent.js, docs/CONSENT.md). consentId is a hash of a
//   hash of the participant's withdrawal code, so only the code holder can find
//   the record or withdraw it. A withdrawn consent unlocks erasing its response.
// - withdrawal_requests/<id>: "I lost my code" requests from retirar.html,
//   handled by an admin in retiros.html.
// - response_export_meta/<surveyId>/flags/<responseId>: exclusion-flag
//   metadata for CSV export, read/written by admin.html
//   (both Google-auth gated).
//
// ACCESS MODEL (docs/ACCESS.md)
//  - Super admins: the two addresses in isAdmin() below. Everything, incl. paradata.
//  - Staff: any verified Google account @umag.cl (or an address exempted in
//    access/<email>.exempt). Staff create surveys (they become its owner), edit their
//    own, read the responses of surveys they own or were added to, and add other
//    @umag.cl colleagues (collab/). Adding anyone else is a super-admin decision.
//  - Paradata/metadata (timings, device, events…) lives apart from the answers, in
//    responses/<survey>/paradata/<id>, readable only with access/<email>.paradata == true
//    (granted by a super admin from super.html) — staff get answers only by default.
//  - Legacy per-survey viewers: surveys/<id>.adminEmails (editable only by super admins).
//
// IMPORTANT: the super-admin list below must stay in sync with SUPER_ADMINS in js/access.js.

service cloud.firestore {
  match /databases/{database}/documents {

    function verifiedGoogle() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function emailLc() { return request.auth.token.email.lower(); }

    function isAdmin() {
      return verifiedGoogle() &&
        request.auth.token.email in [
          'hermanelgueta@gmail.com',
          'herman.elgueta@umag.cl'
        ];
    }

    function isUmag() { return emailLc().matches('^[a-z0-9._%+-]+@umag[.]cl$'); }

    function accessPath() { return /databases/$(database)/documents/access/$(emailLc()); }

    // Can create surveys: @umag.cl accounts, plus addresses a super admin exempted.
    function isStaff() {
      return verifiedGoogle() && (isUmag() || isAdmin() ||
        (exists(accessPath()) && get(accessPath()).data.get('exempt', false) == true));
    }

    // Can read paradata/metadata: super admins and accounts granted it in access/<email>.
    function hasParadata() {
      return isAdmin() || (verifiedGoogle() && exists(accessPath()) &&
        get(accessPath()).data.get('paradata', false) == true);
    }

    function surveyData(surveyId) {
      return get(/databases/$(database)/documents/surveys/$(surveyId)).data;
    }
    function collabPath(surveyId) {
      return /databases/$(database)/documents/collab/$(surveyId + '__' + emailLc());
    }
    function isOwner(surveyId) {
      return verifiedGoogle() && surveyData(surveyId).get('ownerEmail', '') == emailLc();
    }
    function isCollab(surveyId) { return verifiedGoogle() && exists(collabPath(surveyId)); }

    // Legacy per-survey viewers: surveys/<id>.adminEmails (lowercase).
    function signedInEmailIn(list) {
      return verifiedGoogle() && emailLc() in list;
    }

    function isSurveyAdmin(surveyId) {
      return signedInEmailIn(surveyData(surveyId).get('adminEmails', []));
    }

    // Reads the answers of a survey: owner, collaborators, legacy viewers, super admins.
    function isSurveyStaff(surveyId) {
      return isAdmin() || isOwner(surveyId) || isCollab(surveyId) || isSurveyAdmin(surveyId);
    }

    function surveyIsPublished(surveyId) {
      return exists(/databases/$(database)/documents/surveys/$(surveyId)) &&
        get(/databases/$(database)/documents/surveys/$(surveyId)).data.published == true;
    }

    // True when `cid` names a consent record that has been withdrawn.
    function consentWithdrawn(cid) {
      return cid is string && cid.matches('^[a-f0-9]{64}$') &&
        exists(/databases/$(database)/documents/consents/$(cid)) &&
        get(/databases/$(database)/documents/consents/$(cid)).data.status == 'withdrawn';
    }

    // A retry of a write that already landed (flaky network, offline outbox): the
    // document is identical except for its server timestamp.
    function sameExcept(field) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field]) &&
        request.resource.data[field] == request.time;
    }

    match /surveys/{surveyId} {
      allow read: if resource.data.published == true || isAdmin() ||
        (verifiedGoogle() && resource.data.ownerEmail == emailLc()) ||
        signedInEmailIn(resource.data.get('adminEmails', [])) ||
        isCollab(surveyId);

      // Staff create surveys as their owner. adminEmails (legacy viewers) stays a
      // super-admin-only field; colleagues are added through collab/ instead.
      allow create: if isAdmin() || (isStaff() &&
        request.resource.data.ownerEmail == emailLc() &&
        request.resource.data.get('adminEmails', []).size() == 0);

      // Owner and editor collaborators edit; nobody but a super admin changes the
      // owner or the legacy viewer list. Deleting is super-admin only (responses and
      // their rules hang off the survey document): staff unpublish instead.
      allow update: if isAdmin() || (verifiedGoogle() &&
        (resource.data.ownerEmail == emailLc() ||
          (isCollab(surveyId) && get(collabPath(surveyId)).data.role == 'editor')) &&
        request.resource.data.ownerEmail == resource.data.ownerEmail &&
        request.resource.data.get('adminEmails', []) == resource.data.get('adminEmails', []));
      allow delete: if isAdmin();
    }

    // Colleagues added to a survey. Doc id = <surveyId>__<email>. The survey owner may
    // add @umag.cl addresses only; any other address (an exemption) needs a super admin.
    match /collab/{collabId} {
      allow read: if isAdmin() ||
        (verifiedGoogle() && resource.data.email == emailLc()) ||
        (verifiedGoogle() && isOwner(resource.data.surveyId));
      allow create: if verifiedGoogle() &&
        request.resource.data.keys().hasOnly(['surveyId', 'email', 'role', 'addedBy', 'createdAt']) &&
        request.resource.data.surveyId is string && request.resource.data.email is string &&
        request.resource.data.email == request.resource.data.email.lower() &&
        collabId == request.resource.data.surveyId + '__' + request.resource.data.email &&
        request.resource.data.role in ['viewer', 'editor'] &&
        request.resource.data.addedBy == emailLc() &&
        (isAdmin() || (isOwner(request.resource.data.surveyId) &&
          request.resource.data.email.matches('^[a-z0-9._%+-]+@umag[.]cl$')));
      allow update: if isAdmin() || (verifiedGoogle() && isOwner(resource.data.surveyId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role']) &&
        request.resource.data.role in ['viewer', 'editor']);
      allow delete: if isAdmin() || (verifiedGoogle() && isOwner(resource.data.surveyId));
    }

    // Per-account switches set from super.html: { paradata: bool, exempt: bool, note }.
    // An account can read its own record (the UI needs to know what to show).
    match /access/{accessId} {
      allow get: if isAdmin() || (verifiedGoogle() && accessId == emailLc());
      allow list, write: if isAdmin();
    }

    match /responses/{surveyId}/entries/{responseId} {
      // Anyone can create a response (public, anonymous survey), but only if
      // the matching survey exists, is published, and the document has the
      // expected shape — stops bots from blind-writing junk documents into
      // unrelated or unpublished collections.
      allow create: if
        surveyIsPublished(surveyId) &&
        request.resource.data.keys().size() <= 30 &&
        request.resource.data.surveyId == surveyId &&
        request.resource.data.answers is map &&
        // a response queued offline must not arrive after its consent was withdrawn
        !consentWithdrawn(request.resource.data.get('consentId', null));

      // Only admins (Google login) can read responses — admin.html needs
      // this for stats/exports.
      allow read: if isSurveyStaff(surveyId);

      // A response is immutable, with two exceptions:
      //  1. re-sending the very same document (retry / offline outbox), and
      //  2. ERASURE — blanking it down to a stub with no answers and no paradata.
      //     Allowed for the survey's admins (manual withdrawal requests) and for
      //     anyone once the linked consent has been withdrawn, which only the
      //     holder of the withdrawal code can do. Field list: STUB_FIELDS in js/consent.js.
      allow update: if
        sameExcept('createdAt') ||
        (
          request.resource.data.keys().hasOnly(
            ['surveyId', 'answers', 'consentId', 'createdAt', 'withdrawn', 'withdrawnAt', 'withdrawnVia']) &&
          request.resource.data.diff(resource.data).unchangedKeys().hasAll(['surveyId']) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['consentId', 'createdAt']) &&
          request.resource.data.answers is map &&
          request.resource.data.answers.size() == 0 &&
          request.resource.data.withdrawn == true &&
          request.resource.data.withdrawnAt == request.time &&
          request.resource.data.withdrawnVia in ['code', 'admin'] &&
          (isSurveyStaff(surveyId) || consentWithdrawn(resource.data.get('consentId', null)))
        );
      // Only a super admin deletes a response outright (survey deletion, super.html); others leave the withdrawal stub.
      allow delete: if isAdmin();
    }

    // Paradata & metadata of a response (timings, device, interaction events, optional
    // location…), written together with the entry. Same posture as entries — public create
    // on a published survey, immutable — but readable only with the paradata permission.
    match /responses/{surveyId}/paradata/{responseId} {
      allow create: if
        surveyIsPublished(surveyId) &&
        request.resource.data.surveyId == surveyId &&
        request.resource.data.keys().size() <= 40;
      allow read: if hasParadata() && isSurveyStaff(surveyId);
      allow update: if request.resource.data == resource.data;    // identical re-send (retry)
      allow delete: if isSurveyStaff(surveyId) ||
        consentWithdrawn(
          get(/databases/$(database)/documents/responses/$(surveyId)/entries/$(responseId))
            .data.get('consentId', null));
    }

    // Audio answers (open-ended items with response: "audio" | "either"): one doc per
    // clip, id = <responseId>__<itemId>, raw audio in `audio` (Bytes). Same posture as
    // entries: public create (published survey only), admin read, immutable — except
    // that a clip is deleted when its response is erased (see entries above).
    // Size cap 700000 bytes keeps us under Firestore's 1 MiB doc limit — keep in sync
    // with MAX_AUDIO_BYTES in js/audioRecorder.js.
    match /responses/{surveyId}/audio/{clipId} {
      allow create: if
        surveyIsPublished(surveyId) &&
        request.resource.data.keys().hasOnly(['surveyId', 'responseId', 'itemId', 'mime', 'durationMs', 'size', 'audio', 'createdAt']) &&
        request.resource.data.surveyId == surveyId &&
        clipId == request.resource.data.responseId + '__' + request.resource.data.itemId &&
        request.resource.data.audio is bytes &&
        request.resource.data.audio.size() > 0 &&
        request.resource.data.audio.size() <= 700000 &&
        request.resource.data.mime is string &&
        request.resource.data.mime.matches('^audio/(webm|mp4|ogg|aac|mpeg)(;.*)?$');
      allow read: if isSurveyStaff(surveyId);
      allow update: if sameExcept('createdAt');
      allow delete: if isSurveyStaff(surveyId) ||
        consentWithdrawn(
          get(/databases/$(database)/documents/responses/$(surveyId)/entries/$(resource.data.responseId))
            .data.get('consentId', null));
    }

    // Consent registry. Readable one document at a time by whoever knows its id
    // (i.e. holds the withdrawal code); never listable by the public.
    match /consents/{consentId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if
        consentId.matches('^[a-f0-9]{64}$') &&
        request.resource.data.keys().hasOnly(
          ['v', 'surveyId', 'surveyTitle', 'responseId', 'status', 'level', 'itemId', 'text',
           'textHash', 'contact', 'audioItems', 'mode', 'clientGrantedAt', 'grantedAt']) &&
        request.resource.data.status == 'granted' &&
        request.resource.data.surveyId is string &&
        surveyIsPublished(request.resource.data.surveyId) &&
        request.resource.data.responseId is string &&
        request.resource.data.responseId.size() <= 64 &&
        request.resource.data.level in ['anonymous', 'personal', 'sensitive'] &&
        request.resource.data.text is string &&
        request.resource.data.text.size() <= 8000 &&
        request.resource.data.audioItems is list &&
        request.resource.data.audioItems.size() <= 50;

      allow update: if
        // WITHDRAWAL by the participant: `proof` must hash to this document's id.
        (
          resource.data.status == 'granted' &&
          request.resource.data.status == 'withdrawn' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'withdrawnAt', 'via', 'proof']) &&
          request.resource.data.via == 'code' &&
          request.resource.data.withdrawnAt == request.time &&
          request.resource.data.proof is string &&
          request.resource.data.proof.matches('^[a-f0-9]{64}$') &&
          hashing.sha256(request.resource.data.proof).toHexString().lower() == consentId
        ) ||
        // WITHDRAWAL executed by an admin after a verified manual request.
        (
          resource.data.status == 'granted' &&
          request.resource.data.status == 'withdrawn' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'withdrawnAt', 'via', 'requestId', 'by']) &&
          request.resource.data.via == 'admin' &&
          request.resource.data.withdrawnAt == request.time &&
          isSurveyStaff(resource.data.surveyId)
        );
      allow delete: if isAdmin();     // survey deletion from super.html (optional there)
    }

    // "I lost my code": anyone can file a request; only admins see and resolve them.
    match /withdrawal_requests/{requestId} {
      allow create: if
        request.resource.data.keys().hasOnly(
          ['surveyId', 'surveyTitle', 'email', 'when', 'details', 'status', 'createdAt']) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.surveyId is string && request.resource.data.surveyId.size() <= 200 &&
        request.resource.data.get('surveyTitle', '') is string && request.resource.data.get('surveyTitle', '').size() <= 300 &&
        request.resource.data.email is string && request.resource.data.email.size() <= 200 &&
        request.resource.data.get('when', '') is string && request.resource.data.get('when', '').size() <= 200 &&
        request.resource.data.get('details', '') is string && request.resource.data.get('details', '').size() <= 2000;
      allow read: if isAdmin() || (resource.data.surveyId is string && resource.data.surveyId != '' && isSurveyStaff(resource.data.surveyId));
      allow update: if
        (isAdmin() || (resource.data.surveyId != '' && isSurveyStaff(resource.data.surveyId))) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'resolution', 'resolvedBy', 'resolvedAt', 'responseId', 'note']);
      allow delete: if isAdmin();
    }

    match /response_export_meta/{surveyId}/flags/{responseId} {
      allow read, write: if isSurveyStaff(surveyId);
    }
  }
}
