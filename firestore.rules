rules_version = '2';

// samplux (samplux-lamp) — Firestore security rules.
//
// To apply: Firebase Console → samplux-lamp → Firestore Database → Rules
// → paste this whole file → Publish. (Or `firebase deploy --only firestore:rules`.)
//
// Paths used by the app:
// - surveys/<surveyId>: a survey definition (items, optionSets, settings),
//   authored via builder.html. Publicly readable once published so index.html
//   can render it; only admins can write.
// - responses/<surveyId>/entries/<responseId>: one survey response, written
//   anonymously by index.html on submit. Validated dynamically against the
//   matching surveys/<surveyId> doc (must exist and be published) instead of
//   a hardcoded id list — new surveys work the moment they're published, no
//   rules redeploy needed.
// - responses/<surveyId>/audio/<responseId>__<itemId>: voice answers (Bytes), see below.
// - response_export_meta/<surveyId>/flags/<responseId>: exclusion-flag
//   metadata for CSV export, read/written by admin.html
//   (both Google-auth gated).
//
// IMPORTANT: keep the email list below in sync with ALLOWED_EMAILS in
// js/adminStats.js and js/builder.js.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in [
          'hermanelgueta@gmail.com',
          'herman.elgueta@umag.cl'
        ];
    }

    // Per-survey admins: surveys/<id>.adminEmails (lowercase), edited in
    // builder.html. They can read that survey's responses and manage its
    // exclusion flags in admin.html — nothing else (no builder, no other surveys).
    function signedInEmailIn(list) {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email.lower() in list;
    }

    function isSurveyAdmin(surveyId) {
      return signedInEmailIn(
        get(/databases/$(database)/documents/surveys/$(surveyId)).data.get('adminEmails', []));
    }

    match /surveys/{surveyId} {
      allow read: if resource.data.published == true || isAdmin() ||
        signedInEmailIn(resource.data.get('adminEmails', []));
      allow create, update, delete: if isAdmin();
    }

    match /responses/{surveyId}/entries/{responseId} {
      // Anyone can create a response (public, anonymous survey), but only if
      // the matching survey exists, is published, and the document has the
      // expected shape — stops bots from blind-writing junk documents into
      // unrelated or unpublished collections.
      allow create: if
        exists(/databases/$(database)/documents/surveys/$(surveyId)) &&
        get(/databases/$(database)/documents/surveys/$(surveyId)).data.published == true &&
        request.resource.data.surveyId == surveyId &&
        request.resource.data.answers is map;

      // Only admins (Google login) can read responses — admin.html needs
      // this for stats/exports. Nobody can edit or
      // delete a response once submitted (immutable by design).
      allow read: if isAdmin() || isSurveyAdmin(surveyId);
      allow update, delete: if false;
    }

    // Audio answers (open-ended items with response: "audio" | "either"): one doc per
    // clip, id = <responseId>__<itemId>, raw audio in `audio` (Bytes). Same posture as
    // entries: public create (published survey only), admin read, immutable.
    // Size cap 700000 bytes keeps us under Firestore's 1 MiB doc limit — keep in sync
    // with MAX_AUDIO_BYTES in js/audioRecorder.js.
    match /responses/{surveyId}/audio/{clipId} {
      allow create: if
        exists(/databases/$(database)/documents/surveys/$(surveyId)) &&
        get(/databases/$(database)/documents/surveys/$(surveyId)).data.published == true &&
        request.resource.data.keys().hasOnly(['surveyId', 'responseId', 'itemId', 'mime', 'durationMs', 'size', 'audio', 'createdAt']) &&
        request.resource.data.surveyId == surveyId &&
        clipId == request.resource.data.responseId + '__' + request.resource.data.itemId &&
        request.resource.data.audio is bytes &&
        request.resource.data.audio.size() > 0 &&
        request.resource.data.audio.size() <= 700000 &&
        request.resource.data.mime is string &&
        request.resource.data.mime.matches('audio/.*');
      allow read: if isAdmin() || isSurveyAdmin(surveyId);
      allow update, delete: if false;
    }

    match /response_export_meta/{surveyId}/flags/{responseId} {
      allow read, write: if isAdmin() || isSurveyAdmin(surveyId);
    }
  }
}
